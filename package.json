{
  "name": "erakis",
  "version": "1.2.0",
  "description": "Erakis provides simple kintone customzation helper with Parcel",
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "erakis": "dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "watch": "tsc -w",
    "test": "mocha"
  },
  "author": "ishigiwa.kenichiro",
  "license": "MIT",
  "dependencies": {
    "@kintone/dts-gen": "^8.0.7",
    "@kintone/rest-api-client": "^5.0.8",
    "chalk": "^5.3.0",
    "cli-table": "^0.3.11",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.15",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/chai": "^4.3.12",
    "@types/cli-table": "^0.3.4",
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/mocha": "^10.0.6",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "kintone"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IshigiwaKenichiro/erakis.git"
  },
  "homepage": "https://github.com/IshigiwaKenichiro/erakis"
}
